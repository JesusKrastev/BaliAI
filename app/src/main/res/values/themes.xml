<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme for the application. -->
    <style name="Theme.Bali" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash Screen theme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation duration. -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated drawable. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/bali</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.Bali</item>
    </style>
</resources>